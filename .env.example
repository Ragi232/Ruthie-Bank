# PostgreSQL connection used by Prisma. Never commit real credentials.
DATABASE_URL="postgresql://ruthie:ruthie@localhost:5432/ruthie_bank?schema=public"
APP_ENV="sandbox"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET=""
# Set true only for isolated local development to display OTPs in the UI.
EXPOSE_DEV_OTP="false"

# Provider credentials are intentionally unset. Integrations must remain unavailable
# until an authorized provider account and sandbox credentials are configured.
PAYMENT_PROVIDER_BASE_URL=""
PAYMENT_PROVIDER_API_KEY=""
FX_PROVIDER_BASE_URL=""
FX_PROVIDER_API_KEY=""
OTP_PROVIDER_API_KEY=""
